generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  WORKER
  ADMIN
  CONTRACTOR
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum CustomerType {
  HOMEOWNER
  SME
  CONTRACTOR
}

enum SkillLevel {
  JUNIOR
  MID
  SENIOR
}

enum JobStatus {
  OPEN
  QUOTED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum JobAssignmentStatus {
  ASSIGNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  FUNDED
  IN_PROGRESS
  SUBMITTED
  APPROVED
  RELEASED
  DISPUTED
}

enum TransactionType {
  DEPOSIT
  HOLD
  RELEASE
  REFUND
  FEE
  PAYOUT
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  READ
}

enum FraudSeverity {
  LOW
  MEDIUM
  HIGH
}

enum Language {
  EN
  SI
  TA
}

// ─── MODELS ──────────────────────────────────────────────────────────────────

model User {
  id                String      @id @default(uuid())
  role              Role?
  fullName          String?
  phone             String      @unique
  email             String?
  passwordHash      String?
  preferredLanguage Language    @default(EN)
  status            UserStatus  @default(PENDING)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  workerProfile     WorkerProfile?
  customerProfile   CustomerProfile?
  
  // Relations
  uploadedMedia          JobMedia[]
  submittedMilestones    MilestoneSubmission[]
  walletAccount          WalletAccount?
  disputesRaised         Dispute[]
  documentsReviewed      DocumentVerificationLog[]
  notifications          Notification[]
  fraudFlags             FraudFlag[]
  
  // Reverse relations for Jobs and Quotes
  quotesSubmitted        Quote[]
  assignedJobs           JobAssignment[]
}

model WorkerProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id])
  
  bio                String?
  yearsExperience    Int?
  baseDailyRate      Decimal?           @db.Decimal(10,2)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  nicNumber          String?
  selfieUrl          String?
  profilePhotoUrl    String?
  avgRating          Decimal            @default(0) @db.Decimal(3,2)
  totalReviews       Int                @default(0)
  jobsCompleted      Int                @default(0)
  
  districtId         Int?
  district           District?          @relation(fields: [districtId], references: [id])
  latitude           Decimal?           @db.Decimal(10,7)
  longitude          Decimal?           @db.Decimal(10,7)
  isAvailable        Boolean            @default(true)
  
  trades             WorkerTrade[]
  serviceAreas       WorkerServiceArea[]
  certifications     Certification[]
  reviews            Review[]           @relation("WorkerReviews")
  documentsLogs      DocumentVerificationLog[]

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model CustomerProfile {
  id              String       @id @default(uuid())
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id])
  
  customerType    CustomerType @default(HOMEOWNER)
  companyName     String?
  address         String?
  
  districtId      Int?
  district        District?    @relation(fields: [districtId], references: [id])
  
  jobs            Job[]
  reviews         Review[]     @relation("CustomerReviews")

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Trade {
  id           Int           @id @default(autoincrement())
  name         String
  category     String
  isActive     Boolean       @default(true)
  
  workerTrades WorkerTrade[]
  jobs         Job[]
}

model WorkerTrade {
  id               String        @id @default(uuid())
  workerProfileId  String
  workerProfile    WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  tradeId          Int
  trade            Trade         @relation(fields: [tradeId], references: [id])
  skillLevel       SkillLevel?
  yearsExperience  Int?
  
  @@unique([workerProfileId, tradeId])
}

// Note: Initially targeting Western Province as per PRD comment.
model District {
  id                   Int                  @id @default(autoincrement())
  name                 String
  province             String               // e.g., "Western Province"
  
  workers              WorkerProfile[]
  customers            CustomerProfile[]
  workerServiceAreas   WorkerServiceArea[]
  jobs                 Job[]
}

model WorkerServiceArea {
  id               String        @id @default(uuid())
  workerProfileId  String
  workerProfile    WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  districtId       Int
  district         District      @relation(fields: [districtId], references: [id])
  city             String?
  radiusKm         Int?
  
  @@unique([workerProfileId, districtId])
}

model Certification {
  id                 String             @id @default(uuid())
  workerProfileId    String
  workerProfile      WorkerProfile      @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  certificateType    String             // e.g., NVQ, CIDA
  certificateNumber  String?
  issuerName         String
  issueDate          DateTime?
  expiryDate         DateTime?
  documentUrl        String
  verificationStatus VerificationStatus @default(PENDING)
}

model Job {
  id              String      @id @default(uuid())
  customerId      String
  customer        CustomerProfile @relation(fields: [customerId], references: [userId])
  
  title           String
  description     String
  
  tradeId         Int
  trade           Trade       @relation(fields: [tradeId], references: [id])
  
  districtId      Int
  district        District    @relation(fields: [districtId], references: [id])
  
  address         String?
  latitude        Decimal?    @db.Decimal(10,7)
  longitude       Decimal?    @db.Decimal(10,7)
  budgetMin       Decimal?    @db.Decimal(10,2)
  budgetMax       Decimal?    @db.Decimal(10,2)
  startDate       DateTime?
  urgency         String?     // normal, urgent
  status          JobStatus   @default(OPEN)
  
  media           JobMedia[]
  quotes          Quote[]
  assignments     JobAssignment[]
  reviews         Review[]
  fraudFlags      FraudFlag[]

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model JobMedia {
  id          String   @id @default(uuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  mediaType   String   // image, video, document
  mediaUrl    String
  uploadedById String
  uploadedBy  User     @relation(fields: [uploadedById], references: [id])
  createdAt   DateTime @default(now())
}

model Quote {
  id              String        @id @default(uuid())
  jobId           String
  job             Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workerId        String
  worker          User          @relation(fields: [workerId], references: [id])
  
  price           Decimal       @db.Decimal(10,2)
  estimatedDays   Int?
  message         String?
  status          QuoteStatus   @default(PENDING)
  
  assignments     JobAssignment[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([jobId, workerId])
}

model JobAssignment {
  id              String              @id @default(uuid())
  jobId           String
  job             Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workerId        String
  worker          User                @relation(fields: [workerId], references: [id])
  quoteId         String
  quote           Quote               @relation(fields: [quoteId], references: [id])
  
  agreedPrice     Decimal             @db.Decimal(10,2)
  startDate       DateTime?
  expectedEndDate DateTime?
  status          JobAssignmentStatus @default(ASSIGNED)
  
  milestones      Milestone[]

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model Milestone {
  id                String              @id @default(uuid())
  jobAssignmentId   String
  jobAssignment     JobAssignment       @relation(fields: [jobAssignmentId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  amount            Decimal             @db.Decimal(10,2)
  sequenceNo        Int
  status            MilestoneStatus     @default(PENDING)
  dueDate           DateTime?
  
  submissions       MilestoneSubmission[]
  disputes          Dispute[]

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model MilestoneSubmission {
  id            String             @id @default(uuid())
  milestoneId   String
  milestone     Milestone          @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  submittedById String
  submittedBy   User               @relation(fields: [submittedById], references: [id])
  notes         String?
  submittedAt   DateTime           @default(now())
  
  media         SubmissionMedia[]
}

model SubmissionMedia {
  id            String              @id @default(uuid())
  submissionId  String
  submission    MilestoneSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  mediaUrl      String
  mediaType     String              // image, video
}

model Review {
  id            String          @id @default(uuid())
  jobId         String
  job           Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  customerId    String
  customer      CustomerProfile @relation("CustomerReviews", fields: [customerId], references: [userId])
  workerId      String
  worker        WorkerProfile   @relation("WorkerReviews", fields: [workerId], references: [userId])
  
  rating        Int
  reviewText    String?
  onTime        Boolean?
  qualityGood   Boolean?
  fairPrice     Boolean?
  goodComm      Boolean?
  
  createdAt     DateTime        @default(now())
  
  @@unique([jobId, customerId, workerId])
}

model WalletAccount {
  id            String              @id @default(uuid())
  userId        String              @unique
  user          User                @relation(fields: [userId], references: [id])
  balance       Decimal             @default(0) @db.Decimal(12,2)
  currency      String              @default("LKR")
  status        String              @default("ACTIVE")
  
  transactions  WalletTransaction[]

  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model WalletTransaction {
  id              String          @id @default(uuid())
  walletAccountId String
  walletAccount   WalletAccount   @relation(fields: [walletAccountId], references: [id], onDelete: Cascade)
  transactionType TransactionType
  referenceType   String          // milestone, job, manual
  referenceId     String?
  amount          Decimal         @db.Decimal(12,2)
  status          TransactionStatus @default(PENDING)
  
  createdAt       DateTime        @default(now())
}

model Dispute {
  id              String        @id @default(uuid())
  jobId           String?
  milestoneId     String?
  milestone       Milestone?    @relation(fields: [milestoneId], references: [id])
  raisedById      String
  raisedBy        User          @relation(fields: [raisedById], references: [id])
  reason          String
  status          DisputeStatus @default(OPEN)
  resolutionNotes String?
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model DocumentVerificationLog {
  id              String        @id @default(uuid())
  workerProfileId String
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  documentType    String        // NIC, Selfie, Cert
  reviewedById    String
  reviewedBy      User          @relation(fields: [reviewedById], references: [id])
  decision        String        // APPROVED, REJECTED
  notes           String?
  
  createdAt       DateTime      @default(now())
}

model Notification {
  id        String             @id @default(uuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   String             // sms, whatsapp, push, email
  title     String
  message   String
  status    NotificationStatus @default(QUEUED)
  
  createdAt DateTime           @default(now())
}

model FraudFlag {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  jobId     String?
  job       Job?          @relation(fields: [jobId], references: [id])
  flagType  String        // fake_doc, no_show, payment_issue, abuse
  severity  FraudSeverity @default(MEDIUM)
  notes     String?
  
  createdAt DateTime      @default(now())
}

model OtpRecord {
  id          String   @id @default(uuid())
  phoneNumber String
  code        String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([phoneNumber])
}
